# ============================================================
# REQUIRED: Anthropic API key
# Create one at https://console.anthropic.com/settings/keys
# ============================================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Chrome DevTools endpoint. Start Chrome with --remote-debugging-port=9222
# (see the README for the exact command on Windows / macOS / Linux).
CDP_ENDPOINT=http://localhost:9222

# scripted = fast mode for Internshala: plain Playwright clicks through the site and
#            the model is only used to score listings and write answers (~1 cent per application)
# agent    = the model drives the browser step by step through Playwright MCP
#            (works on any site, but is slower and much more expensive)
BOT_MODE=scripted

# Model that drives the agent and writes form answers
ANTHROPIC_MODEL=claude-sonnet-5-5

# Cheap model used to score listings in scripted mode (defaults to LLM_AUX_MODEL)
# SCORING_MODEL=claude-haiku-5-5

# ============================================================
# LIMITS
# ============================================================
DAILY_LIMIT=10
MAX_PER_RUN=3

# Random pause between actions, in milliseconds
DELAY_MIN=2000
DELAY_MAX=5000

# true = fill everything but never click the final submit button
DRY_RUN=true

# Minimum match score (1-10) needed to apply
MIN_SCORE=6

# Stop the run once the API spend passes this many USD (0 = no cap)
MAX_COST_USD=2

# ============================================================
# DASHBOARD (local only)
# ============================================================
DASHBOARD_PORT=3000

# ============================================================
# TELEGRAM (optional)
# 1. Create a bot with @BotFather and copy the token
# 2. Message your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# EMAIL REPORTS (optional)
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_RECIPIENT=

# ============================================================
# SCHEDULE (optional): run once a day at CRON_TIME
# ============================================================
CRON_ENABLED=false
CRON_TIME=09:00

# ============================================================
# HELPER LLM for cover letters, tailored resumes and recruiter notes
# Providers: anthropic (default), ollama (local, free), openai (any OpenAI-compatible API)
# ============================================================
LLM_AUX_PROVIDER=anthropic
LLM_AUX_MODEL=claude-haiku-5-5

# Ollama (LLM_AUX_PROVIDER=ollama), e.g. LLM_AUX_MODEL=llama3
OLLAMA_URL=http://localhost:11434

# OpenAI-compatible (LLM_AUX_PROVIDER=openai), e.g. LLM_AUX_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: path to Chrome/Chromium, used to turn tailored resumes into PDFs
# CHROME_PATH=
